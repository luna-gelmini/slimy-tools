+// STREAM ON [ms] / STREAM OFF, see rawstream.h
+void cmdStream(CmdParser* parser) {
+	if (parser->getParamCount() > 1 && parser->equalCmdParam(1, "OFF")) {
+		SlimeVR::RawStream::enabled = false;
+		logger.info("RAW stream OFF");
+		return;
+	}
+
+	uint32_t intervalMs = 100;
+	if (parser->getParamCount() > 2) {
+		const int requested = atoi(parser->getCmdParam(2));
+		if (requested >= 10 && requested <= 60000) {
+			intervalMs = static_cast<uint32_t>(requested);
+		}
+	}
+
+	SlimeVR::RawStream::intervalMs = intervalMs;
+	SlimeVR::RawStream::enabled = true;
+	logger.info("RAW stream ON every %u ms", intervalMs);
+	logger.info("[RAW] columns: sensor millis gx gy gz ax ay az tempC n");
+}
