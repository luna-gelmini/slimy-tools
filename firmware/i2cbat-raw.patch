diff --git a/src/rawstream.h b/src/rawstream.h
new file mode 100644
index 0000000..8469578
--- /dev/null
+++ b/src/rawstream.h
@@ -0,0 +1,25 @@
+/*
+	Raw IMU streaming, shared state.
+
+	Enabled over serial (`STREAM ON [ms]` / `STREAM OFF`) or over UDP
+	(see rawudp.h). Each line reports the mean of the raw samples taken
+	during the interval:
+
+	[RAW] <sensor> <millis> <gx> <gy> <gz> <ax> <ay> <az> <tempC> <samples>
+
+	Gyroscope and accelerometer values are raw sensor units, so the
+	gyroscope bias can be measured without the fusion correcting it.
+*/
+
+#pragma once
+
+#include <cstdint>
+
+namespace SlimeVR {
+namespace RawStream {
+
+inline bool enabled = false;
+inline uint32_t intervalMs = 100;
+
+}  // namespace RawStream
+}  // namespace SlimeVR
diff --git a/src/rawudp.h b/src/rawudp.h
new file mode 100644
index 0000000..29be31a
--- /dev/null
+++ b/src/rawudp.h
@@ -0,0 +1,96 @@
+/*
+	Raw IMU streaming over Wi-Fi.
+
+	The tracker listens for commands on RAW_UDP_PORT and streams back to
+	whoever sent the command, so no address has to be configured:
+
+		RAW ON [ms]   start streaming (default interval 200 ms)
+		RAW OFF       stop
+		RAW PING      reply only, to locate the tracker
+
+	State is kept in RAM: unplugging USB keeps the stream running, a
+	reboot stops it.
+*/
+
+#pragma once
+
+#include <WiFiUdp.h>
+
+#include <cstdint>
+
+#include "rawstream.h"
+
+namespace SlimeVR {
+namespace RawUdp {
+
+constexpr uint16_t Port = 6971;
+
+inline WiFiUDP socket;
+inline bool listening = false;
+inline bool enabled = false;
+inline IPAddress target;
+inline uint16_t targetPort = 0;
+
+inline void send(const char* line) {
+	if (!enabled || targetPort == 0) {
+		return;
+	}
+	socket.beginPacket(target, targetPort);
+	socket.write(reinterpret_cast<const uint8_t*>(line), strlen(line));
+	socket.endPacket();
+}
+
+inline void update() {
+	if (!listening) {
+		if (WiFi.status() != WL_CONNECTED) {
+			return;
+		}
+		listening = socket.begin(Port);
+		if (!listening) {
+			return;
+		}
+	}
+
+	if (socket.parsePacket() <= 0) {
+		return;
+	}
+
+	char buf[64]{};
+	const int read = socket.read(buf, sizeof(buf) - 1);
+	if (read <= 0) {
+		return;
+	}
+	buf[read] = '\0';
+
+	const IPAddress sender = socket.remoteIP();
+	const uint16_t senderPort = socket.remotePort();
+	char reply[48]{};
+
+	if (strncmp(buf, "RAW ON", 6) == 0) {
+		int ms = atoi(buf + 6);
+		if (ms < 20 || ms > 60000) {
+			ms = 200;
+		}
+		RawStream::intervalMs = static_cast<uint32_t>(ms);
+		RawStream::enabled = true;
+		target = sender;
+		targetPort = senderPort;
+		enabled = true;
+		snprintf(reply, sizeof(reply), "OK ON %d", ms);
+	} else if (strncmp(buf, "RAW OFF", 7) == 0) {
+		enabled = false;
+		RawStream::enabled = false;
+		snprintf(reply, sizeof(reply), "OK OFF");
+	} else if (strncmp(buf, "RAW PING", 8) == 0) {
+		snprintf(reply, sizeof(reply), "OK PING");
+	} else {
+		return;
+	}
+
+	socket.beginPacket(sender, senderPort);
+	socket.write(reinterpret_cast<const uint8_t*>(reply), strlen(reply));
+	socket.endPacket();
+}
+
+}  // namespace RawUdp
+}  // namespace SlimeVR
